# GlitchTip reporting is on only in apps packaged by GitHub Actions:
# the Release workflow reports as production, PR builds as preview.
# `bun run dev`, tests and apps packaged locally never report unless forced.
# Electron does not load .env files; pass these variables in its environment.
# Sends errors and structured logs from main and renderer. In GlitchTip Logs,
# choose Service = pairkiller; runtime distinguishes server (main) and browser.
# Logs retain app/rule names, paths, device hostname, error messages and stacks.
# Only secrets (passwords, tokens, cookies, session ids, OAuth secrets,
# signed URL signatures and card data) are filtered. No hosting token is needed.

# Optional: report from a local run on purpose (tagged development).
SENTRY_FORCE=0

# Optional: override the destination. This alone does not enable reporting.
# SENTRY_DSN=https://9d9c2ec177654b48bdce3e218aca0d3a@error.cnnct.uk/8

# Optional: disable all reporting, including releases. Tests are always disabled.
# The in-app Send error reports preference also controls logs.
SENTRY_DISABLED=false
