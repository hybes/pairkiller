{
  "name": "pairkiller",
  "productName": "Pairkiller",
  "version": "7.0.0",
  "description": "A modern, flexible app monitoring and control system with enhanced UI and performance",
  "main": "src/main/index.js",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "bunx electron-builder --publish never",
    "build:all": "bunx electron-builder --mac --win --linux --publish never",
    "build:mac": "bunx electron-builder --mac --publish never",
    "build:win": "bunx electron-builder --win --publish never",
    "build:linux": "bunx electron-builder --linux --publish never",
    "build:icons": "bun run build:icons:setup",
    "build:icons:setup": "bun scripts/copy-icon.js",
    "build:icons:create": "echo ImageMagick not available - using PNG icon for all formats",
    "bump": "bunx commit-and-tag-version --skip.tag",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "dist": "bunx electron-builder --publish never",
    "pack": "bunx electron-builder --dir --publish never",
    "lint": "eslint .",
    "test": "bun test/run.js",
    "release": "bun run build:icons && bun run build:all"
  },
  "build": {
    "appId": "com.pairkiller.app",
    "productName": "Pairkiller",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "icon.png",
      "trayTemplate.png",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc,lib}/**",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/build/koffi/win32_ia32/**",
      "!node_modules/koffi/build/koffi/**/*.{exp,lib}"
    ],
    "extraResources": [
      {
        "from": "build/icons/",
        "to": "icons/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "electronUpdaterCompatibility": ">=5.0.0",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "electronUpdaterCompatibility": ">=5.0.0",
      "icon": "build/icons/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icons/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "maintainer": "Ben Hybert <ben@example.com>",
      "vendor": "Ben Hybert",
      "synopsis": "Modern app monitoring and companion app management tool",
      "description": "Pairkiller is a cross-platform application that monitors running programs and automatically manages companion applications. Perfect for gamers who want to automatically start/stop tools like Blitz, BakkesMod, or other companion apps when specific games are detected."
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icons/icon.png",
      "background": null,
      "backgroundColor": "#ffffff",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      },
      "format": "UDZO",
      "internetEnabled": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pairkiller",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Pairkiller ${version}",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "packElevateHelper": false,
      "displayLanguageSelector": false,
      "menuCategory": false,
      "installerLanguages": [
        "en_US"
      ],
      "include": "build/installer.nsh",
      "warningsAsErrors": false,
      "unicode": true,
      "guid": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "installerSidebar": null,
      "uninstallerSidebar": null,
      "multiLanguageInstaller": false,
      "removeDefaultUninstallWelcomePage": false
    },
    "snap": {
      "summary": "App monitoring and control system"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hybes",
        "repo": "pairkiller",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "npmRebuild": false
  },
  "keywords": [
    "electron",
    "app",
    "monitor",
    "automation",
    "productivity",
    "gaming",
    "utility"
  ],
  "author": {
    "name": "Ben Hybert",
    "email": "ben@hybert.com",
    "url": "https://github.com/hybes"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hybes/pairkiller"
  },
  "bugs": {
    "url": "https://github.com/hybes/pairkiller/issues"
  },
  "homepage": "https://github.com/hybes/pairkiller#readme",
  "dependencies": {
    "@sentry/electron": "^8.2.0",
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "commit-and-tag-version": "^13.2.2",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
